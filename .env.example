# Copy this file to .env.local and fill in the values from your Supabase project
# (Supabase dashboard -> Project Settings -> API).
#
# Both values are safe to expose in a browser bundle, but .env.local is git-ignored
# anyway so that project-specific values never end up in the repository.
#
# Restart `npm run dev` after changing these.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key
